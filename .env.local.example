# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed, it holds real secrets.

# Supabase project URL and anon (public) key, from Project Settings > API.
# The anon key is safe to expose to the browser (NEXT_PUBLIC_*) as long as
# Row Level Security policies are set up on your tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key, from the same page. Full database access,
# bypasses Row Level Security. Server-side only, never prefix with
# NEXT_PUBLIC_ or it will leak into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API key, from resend.com, for sending contact-form emails.
RESEND_API_KEY=your-resend-api-key
